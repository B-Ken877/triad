# ----------------------------------------------------------------------------
# TRIAD environment example — copy to .env.local and fill in real values.
# NEVER commit a filled .env file. Never reuse Medika credentials, database
# URLs, auth/session secrets or production environment values here.
# ----------------------------------------------------------------------------

# ---- Database (Neon PostgreSQL) ---------------------------------------------
# Server-side only. Prisma datasource. Example:
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/triad?sslmode=require"

# ---- Auth -------------------------------------------------------------------
# Secret used for signing sessions/tokens (Phase 3+). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ---- Object storage (private attachments, Phase 4+) -------------------------
# Credentials for the private object-storage adapter. Server-side only.
STORAGE_DRIVER="s3"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ---- Model provider integrations (Phase 7+) --------------------------------
# Provider API keys are stored server-side, encrypted at rest, and are never
# returned to clients after creation. The vars below are only bootstrap
# defaults for local development.
MODEL_PROVIDER_API_KEY=""

# ---- Operational flags ------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"
