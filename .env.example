# TRIAD — use TRIAD-only values. Never copy Medika credentials or database URLs.
DATABASE_URL="postgresql://user:password@host/triad?sslmode=require"

# Neon Managed Auth base URL for the TRIAD Neon branch.
# Example: https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=""

# Private object storage (future phase)
STORAGE_DRIVER="s3"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Model provider keys are added in Phase 7 and must remain server-side.
MODEL_PROVIDER_API_KEY=""
LOG_LEVEL="info"
